{
  "name": "restmodel-workspace",
  "private": true,
  "packageManager": "pnpm@8.10.5",
  "engines": {
    "node": ">=22",
    "pnpm": ">=8 <9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write \"{packages,extensions,development}/**/*.{ts,mts,mjs}\"",
    "format:check": "prettier --check \"{packages,extensions,development}/**/*.{ts,mts,mjs}\"",
    "check:packages": "pnpm build && node development/check-packages.mjs",
    "check:browser": "pnpm build && node development/check-browser.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm format:check && node development/check-packages.mjs && node development/check-browser.mjs",
    "docs:dev": "pnpm --dir apps/docs dev",
    "docs:build": "pnpm --dir apps/docs build",
    "docs:preview": "pnpm --dir apps/docs preview",
    "docs:check": "pnpm --dir apps/docs check",
    "docs:deploy": "node apps/docs/scripts/deploy.mjs",
    "test:live": "pnpm --filter @restmodel/restmodel build && node --test --test-concurrency=1 development/open-platforms/live.test.mjs",
    "demo": "pnpm --filter @restmodel/restmodel build && node development/open-platforms/demo.mjs",
    "demo:gitee": "pnpm demo gitee",
    "demo:github": "pnpm demo github",
    "release:prepare": "pnpm typecheck && pnpm test && pnpm format:check && node development/check-browser.mjs && node development/check-packages.mjs --pack-destination artifacts/release/0.1.0"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vitepress": "1.6.4"
  },
  "license": "MIT"
}
